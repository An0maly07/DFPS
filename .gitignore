# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Env / secrets (.env.local is also written by `vercel link`)
.env*
!.env.example
backend/secrets/
*.serviceaccount.json
firebase-adminsdk*.json

# API response cache (re-fetchable)
backend/data/cache/

# Node / Next.js
node_modules/
.next/
out/
.vercel

# Data artifacts (large rasters cached locally, re-derivable from GEE)
backend/data/cog_exports/**/*.tif
backend/data/cog_exports/**/*.tiff

# ML artifacts (Prithvi weights/ONNX are large; re-downloadable / re-exportable)
*.onnx
*.ubj
*.joblib
*.pth
*.pt
*.ckpt
backend/data/prithvi/
lightning_logs/

# Recorded fallback demo video (large; regenerate with scripts/record_demo.mjs)
docs/*.webm

# OS / editor
.DS_Store
Thumbs.db
