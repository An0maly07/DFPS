# Copy to .env and fill in. Never commit .env.

# --- Google Earth Engine ---
# Cloud project ID registered for Earth Engine (noncommercial)
GEE_PROJECT_ID=
# Optional: path to a service-account JSON if not using interactive ee.Authenticate()
GEE_SERVICE_ACCOUNT_JSON=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: backend writes only, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for schema migration via psql/psycopg)
SUPABASE_DB_URL=

# --- TiTiler ---
# URL of the deployed TiTiler instance (local default below)
TITILER_URL=http://localhost:8001

# --- Alerting (Phase 2 only) ---
FIREBASE_SERVICE_ACCOUNT_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Target region defaults (Kolhapur–Sangli, Maharashtra) ---
DEFAULT_LAT=16.70
DEFAULT_LON=74.24
